  "world": {
    "axioms": [
      {
        "id": "ax-1",
        "text": "潮汐每三十日一次，退潮时露出可通行的盐滩。"
      },
      {
        "id": "ax-2",
        "text": "没有跨越远海的常备航线，消息靠沿岸驿站与盐户口传传递。"
      },
      {
        "id": "ax-3",
        "text": "碑刻是唯一能跨代留下的记录；写碑的人不一定留名。"
      }
    ],
    "geography": "三条沿岸城邦带（北堤、南堤、盐关），内陆为盐碱荒原。通行依赖退潮后露出的盐滩，涨潮期间城邦之间只剩驿站之间的一条岸道。",
    "society": "城邦由堤长议会治理：堤长执事、守碑人管碑、盐户管滩场。驿站信报是公共消息来源，盐户口传则更早、更碎，也更容易失真。",
    "lexicon": {
      "note": "城邦名为两字，人名带堤、潮、盐的偏旁。",
      "terms": [
        {
          "term": "堤长",
          "meaning": "城邦议会的执事者"
        },
        {
          "term": "通行牌",
          "meaning": "退潮日进出盐滩的凭据，由堤长议会发放"
        },
        {
          "term": "水位尺",
          "meaning": "立在滩口记潮位刻线的石尺，堤务吏每日读一次"
        }
      ]
    },
    "institutions": [
      {
        "id": "inst-1",
        "name": "堤长议会",
        "mandate": "议定堤务、征发修补人力与发放退潮通行牌",
        "scope": "三条沿岸城邦",
        "succession": "堤长身故或去职时由同城邦议席推举接任；空缺期间日常堤务照旧、通行牌发放与碑文校订暂停",
        "validity": "自崩塌后第 2 年沿用至今",
